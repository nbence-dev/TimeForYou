# ─────────────────────────────────────────────────────────────────────────────
# TimeForYou — environment template.
#
# THIS FILE IS COMMITTED. It must never contain a real value.
# Copy it, then fill the copy in:   cp .env.example .env
# .env is git-ignored and must stay that way.
#
# Anything marked CHANGEME is a secret. Anything else is just configuration.
# See docs/secrets.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=timeforyou
POSTGRES_USER=timeforyou
POSTGRES_PASSWORD=CHANGEME_generate_with__openssl_rand_-base64_24

# Read by the C# API and Worker. __ (double underscore) maps to configuration
# nesting in .NET: this becomes ConnectionStrings:TimeForYou
ConnectionStrings__TimeForYou=Host=db;Port=5432;Database=timeforyou;Username=timeforyou;Password=CHANGEME_same_as_POSTGRES_PASSWORD

# ── Credential encryption (brief §11.5) ──────────────────────────────────────
# AES-256-GCM. Must be exactly 32 bytes, base64-encoded.
#   generate:  openssl rand -base64 32
# Rotating: add the new key, bump the version, keep the old key readable until
# every stored record has been re-encrypted.
TIMEFORYOU_ENCRYPTION_KEY=CHANGEME_openssl_rand_-base64_32
TIMEFORYOU_ENCRYPTION_KEY_VERSION=1

# ── WebUntis source ──────────────────────────────────────────────────────────
# Point at the mock for demos and marking; at the real tenant for live use.
#   mock:  http://mock:8000
#   live:  https://<server>.webuntis.com
WEBUNTIS_BASE_URL=http://mock:8000
WEBUNTIS_SCHOOL=eduvos

# ── Push notifications ───────────────────────────────────────────────────────
# Firebase service account JSON, for native Android push.
# Download from the Firebase console; save it OUTSIDE the repo; mount it in.
# The file itself is git-ignored by name, but do not keep it in the repo at all.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=CHANGEME_your_firebase_project_id

# Web Push (VAPID) for the iOS PWA.
#   generate:  npx web-push generate-vapid-keys
# The PUBLIC key ships to the browser and is not a secret. The PRIVATE key is.
VAPID_PUBLIC_KEY=CHANGEME_public_key
VAPID_PRIVATE_KEY=CHANGEME_private_key
VAPID_SUBJECT=mailto:team@example.com

# ── Mock WebUntis admin ──────────────────────────────────────────────────────
# Guards POST /admin/trigger-change so a demo cannot be hijacked from the tunnel.
MOCK_ADMIN_TOKEN=CHANGEME_openssl_rand_-hex_16

# ── Public tunnel (team instance only — the marker does not need this) ───────
CLOUDFLARE_TUNNEL_TOKEN=CHANGEME_from_cloudflare_zero_trust_dashboard

# ── Not secret: behaviour config ─────────────────────────────────────────────
POLL_INTERVAL_SECONDS=900        # demo/marking: 30
QUIET_HOURS_START=21:00
QUIET_HOURS_END=06:00
CHANGE_WINDOW_DAYS=14
ASPNETCORE_ENVIRONMENT=Development

# ── App (Expo) — PUBLIC BY DEFINITION ────────────────────────────────────────
# EXPO_PUBLIC_* values are compiled into the JavaScript bundle and readable by
# anyone who downloads the app. NEVER put a secret behind this prefix.
EXPO_PUBLIC_API_URL=http://localhost:8080
