# ─────────────────────────────────────────────────────────────────────────────
# TimeForYou — environment template.
#
# THIS FILE IS COMMITTED. It must never contain a real value.
# Copy it, then fill the copy in:   cp .env.example .env
# .env is git-ignored and must stay that way.
#
# Anything marked CHANGEME is a secret. Anything else is just configuration.
# See docs/secrets.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=timeforyou
POSTGRES_USER=timeforyou
POSTGRES_PASSWORD=CHANGEME_generate_with__openssl_rand_-base64_24

# Read by the C# API and Worker. __ (double underscore) maps to configuration
# nesting in .NET: this becomes ConnectionStrings:TimeForYou
ConnectionStrings__TimeForYou=Host=db;Port=5432;Database=timeforyou;Username=timeforyou;Password=CHANGEME_same_as_POSTGRES_PASSWORD

# ── Credential encryption (brief §11.5) ──────────────────────────────────────
# The WebUntis SSO secret is encrypted at rest with the ASP.NET Core
# DataProtection API — not hand-rolled AES. Key material comes from here.
#   generate:  openssl rand -base64 32
#
# This key is NOT rotated. A 6-user prototype on a laptop does not justify a
# rotation procedure, and pretending otherwise would be documentation theatre.
# If the key leaks, generate a new one and re-onboard the six users by QR.
AES_KEY=CHANGEME_openssl_rand_-base64_32

# ── WebUntis source ──────────────────────────────────────────────────────────
# One hop, one variable. The university's real timetable system has no
# reachable API, so `mock` is not a demo stand-in — it is the only backend
# there is. api/worker talk to it directly; there is no sidecar to flip.
WEBUNTIS_BASE_URL=http://mock:8000
WEBUNTIS_SCHOOL=eduvos

# ── Push notifications ───────────────────────────────────────────────────────
# FCM is the single transport for BOTH targets: native FCM on Android, FCM Web
# registration tokens for the iOS PWA. There are no VAPID keys — the Firebase
# Web SDK manages that layer itself.
#
# Firebase service account JSON. Download from the Firebase console; save it
# OUTSIDE the repo; mount it in. Do not keep it in the repo at all.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=CHANGEME_your_firebase_project_id

# Host-side path to that same JSON file — docker-compose.yml bind-mounts this
# into api and worker at the container path above. CHANGEME to wherever you
# saved the download, e.g. ~/secrets/timeforyou-firebase.json
FIREBASE_SERVICE_ACCOUNT_PATH=CHANGEME_absolute_path_to_firebase_service_account_json

# The Firebase Web config the PWA needs to obtain an FCM registration token.
# Public by definition — it ships in the JS bundle. Not a secret.
EXPO_PUBLIC_FIREBASE_API_KEY=CHANGEME_web_api_key
EXPO_PUBLIC_FIREBASE_APP_ID=CHANGEME_web_app_id
EXPO_PUBLIC_FIREBASE_SENDER_ID=CHANGEME_messaging_sender_id
EXPO_PUBLIC_FIREBASE_PROJECT_ID=CHANGEME_your_firebase_project_id

# ── Mock WebUntis admin ──────────────────────────────────────────────────────
# The mock's admin endpoints (/mock/cancel-lesson/{id}, /move-lesson/{id},
# /change-room/{id}, /restore-lesson/{id}, /reset) and the /demo controller page
# are deliberately UNAUTHENTICATED. The mock is never exposed through the tunnel,
# so the LAN is the security boundary. There is no token here on purpose — do not
# add one.
#
# Where the mock forwards the /demo page's "Nudge now" button. The worker's own
# POST /nudge is on port 8081; the browser cannot call it cross-origin, so the
# mock proxies. The default works with the bundled compose file; the deploy
# compose overrides it with the release alias.
# WORKER_NUDGE_URL=http://worker:8081/nudge

# ── Public tunnel (team instance only — the marker does not need this) ───────
# Routes /api/* and /ics/* to the API. Everything else 404s. The mock, the
# Hangfire dashboard and Postgres stay LAN-only.
CLOUDFLARE_TUNNEL_TOKEN=CHANGEME_from_cloudflare_zero_trust_dashboard

# The externally reachable origin of the API, used to build the calendar feed URL
# returned by GET /calendar. Leave blank for a local run: the URL is then built from
# the origin the request arrived on. On the team instance set it to the tunnel's
# https URL (e.g. https://tfy.example.org), because behind cloudflared the request
# arrives as plain http. No trailing slash needed.
PUBLIC_BASE_URL=

# The public https origin of the web app (e.g. https://timeforyou.co.za). The worker uses it to
# make a tapped web push open /changes. FCM only accepts an absolute https link, so anything else
# (http://..., a bare host) is ignored with a warning at startup. Blank = no link.
WEB_APP_URL=

# ── Not secret: behaviour config ─────────────────────────────────────────────
# 10 minutes = 36 requests/hour/user against WebUntis, which is safe for 6 users.
POLL_INTERVAL_SECONDS=600        # demo/marking: 30
# Host port for the worker's POST /nudge and Hangfire dashboard (/hangfire). LAN-only,
# unauthenticated, never tunnelled.
WORKER_PORT=8081
ASPNETCORE_ENVIRONMENT=Development

# Deliberately absent: QUIET_HOURS_START/END and CHANGE_WINDOW_DAYS.
#   - Quiet hours (brief FR-25) are DEFERRED out of Phase 1, together with
#     reminder customisation. Suppressing a grouped batch and replaying it later
#     conflicts with "one notification per poll cycle" and was never designed.
#     The requirement still stands; nothing implements it before 2026-10-23.
#   - The seven-week lookahead window (issue #59, spec #3) is still real behaviour,
#     it is just fixed in code (TimetableWindow) rather than configurable. Nothing
#     needs to tune it for 6 users.

# ── App (Expo) — PUBLIC BY DEFINITION ────────────────────────────────────────
# EXPO_PUBLIC_* values are compiled into the JavaScript bundle and readable by
# anyone who downloads the app. NEVER put a secret behind this prefix.
# Expo reads these from app/, not from this root file: put per-machine overrides in
# app/.env.local (git-ignored). On a phone, "localhost" is the phone, so use your Mac's LAN IP,
# e.g. http://192.168.1.20:8080, and restart with `npx expo start --clear`.
EXPO_PUBLIC_API_URL=http://localhost:8080
